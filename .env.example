# ---------------------------------------------------------------------------
# Damazon - environment configuration template
# Copy to .env and fill in real values. Never commit a populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://damazon:damazon_dev_password@localhost:5432/damazon?schema=public&connection_limit=20&pool_timeout=20
DATABASE_POOL_SIZE=20

# Redis (required in staging/production for shared rate limits)
REDIS_URL=redis://localhost:6379

# Authentication - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-of-random-data
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-32-plus-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Password hashing (scrypt)
PASSWORD_SCRYPT_COST=16
PASSWORD_SCRYPT_BLOCK_SIZE=8
PASSWORD_SCRYPT_PARALLELIZATION=1
PASSWORD_MAX_AGE_DAYS=180

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_SECONDS=900

# Object storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=damazon-media
STORAGE_ACCESS_KEY=damazon
STORAGE_SECRET_KEY=replace-with-storage-secret
STORAGE_REGION=syria
STORAGE_FORCE_PATH_STYLE=true

# Required for registration verification and password recovery in staging/production.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=mailer-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=no-reply@example.com

# Frontend origins allowed to call the API
CUSTOMER_APP_ORIGIN=http://localhost:5173
ADMIN_APP_ORIGIN=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend cross-links (read by the Vite apps at build time)
# Customer profile links admins to the console; console sidebar links back.
VITE_CONSOLE_URL=http://localhost:5174
VITE_STOREFRONT_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Platform defaults
DEFAULT_COUNTRY=SY
DEFAULT_CURRENCY=SYP
DEFAULT_LOCALE=ar