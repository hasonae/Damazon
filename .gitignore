# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
.eslintcache

# Accidental tsc emit next to TypeScript sources (real output goes to dist/).
# Left in place these shadow the .ts/.tsx sources during Vite resolution.
apps/**/src/**/*.js
apps/**/src/**/*.d.ts
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts.map
packages/**/src/**/*.js
packages/**/src/**/*.d.ts
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts.map

# Test / coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Environment and secrets (Rule 17: never hardcode secrets, never commit sensitive data)
.env
.env.*
!.env.example
*.pem
*.key
!deployment/**/*.key.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Local databases and uploads
database/backups/*
!database/backups/.gitkeep
.tmp/
uploads/
