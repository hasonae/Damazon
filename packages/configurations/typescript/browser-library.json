{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Damazon Browser Library",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"]
}
