generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY DOMAIN
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  PENDING_DELETION
  DELETED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
}

enum UserRole {
  customer
  merchant
  restaurant
  delivery_company
  driver
  admin
}

enum AdminDepartment {
  super_admin
  operations
  finance
  support
  marketing
  content
  moderation
  security
}

enum LocaleCode {
  ar
  en
}

model User {
  id                        String     @id @default(uuid()) @db.Uuid
  firstName                 String     @map("first_name") @db.VarChar(80)
  lastName                  String     @map("last_name") @db.VarChar(80)
  phone                     String     @unique @db.VarChar(20)
  email                     String?    @unique @db.VarChar(254)
  supabaseUserId            String?    @unique @map("supabase_user_id") @db.Uuid
  username                  String?    @unique @db.VarChar(32)
  passwordHash              String     @map("password_hash") @db.VarChar(255)
  avatarUrl                 String?    @map("avatar_url") @db.VarChar(500)
  locale                    LocaleCode @default(ar)
  status                    UserStatus @default(ACTIVE)
  phoneVerifiedAt           DateTime?  @map("phone_verified_at")
  emailVerifiedAt           DateTime?  @map("email_verified_at")
  emailVerificationRequired Boolean    @default(false) @map("email_verification_required")
  lastLoginAt               DateTime?  @map("last_login_at")
  failedLoginAttempts       Int        @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?  @map("locked_until")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  roles                       UserRoleAssignment[]
  sessions                    UserSession[]
  addresses                   UserAddress[]
  ownedZones                  DamazonZone[]                @relation("ZoneOwner")
  ownedBusinesses             Business[]                   @relation("BusinessOwner")
  driverProfile               Driver?
  adminProfile                AdminProfile?
  cart                        Cart?
  customerOrders              Order[]                      @relation("OrderCustomer")
  reviews                     Review[]
  favorites                   Favorite[]
  notifications               Notification[]
  messagesSent                Message[]
  conversations               ConversationParticipant[]
  supportTickets              SupportTicket[]
  auditLogs                   AuditLog[]
  emailVerificationChallenges EmailVerificationChallenge[]
  identityMigration           SupabaseIdentityMigration?
  authLoginChallenges         SupabaseLoginChallenge[]
  authRecoveryChallenges      SupabaseRecoveryChallenge[]
  createdAdvertisements       Advertisement[]              @relation("AdvertisementCreator")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model SupabaseIdentityMigration {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  supabaseUserId  String    @unique @map("supabase_user_id") @db.Uuid
  attempts        Int       @default(0)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  expiresAt       DateTime  @map("expires_at")
  lastSentAt      DateTime  @default(now()) @map("last_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("supabase_identity_migrations")
}

model SupabaseLoginChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  supabaseUserId String    @map("supabase_user_id") @db.Uuid
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("supabase_login_challenges")
}

model SupabaseRecoveryChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  supabaseUserId  String    @map("supabase_user_id") @db.Uuid
  attempts        Int       @default(0)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  lastSentAt      DateTime  @default(now()) @map("last_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("supabase_recovery_challenges")
}

model EmailVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @default("verify") @db.VarChar(16)
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
  @@map("email_verification_challenges")
}

model UserRoleAssignment {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  role             UserRole
  status           VerificationStatus @default(PENDING)
  activeBusinessId String?            @map("active_business_id") @db.Uuid
  statusReasonCode String?            @map("status_reason_code") @db.VarChar(64)
  statusNote       String?            @map("status_note") @db.VarChar(500)
  reviewedById     String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBusiness Business? @relation("ActiveBusinessRole", fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role, status])
  @@map("user_roles")
}

model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  userAgent      String?   @map("user_agent") @db.VarChar(400)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason") @db.VarChar(120)
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(80)
  addressLine String   @map("address_line") @db.VarChar(400)
  landmark    String?  @db.VarChar(200)
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  cityId      String?  @map("city_id") @db.Uuid
  zoneId      String?  @map("zone_id") @db.Uuid
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  zone DamazonZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_addresses")
}

// ---------------------------------------------------------------------------
// GEOGRAPHY DOMAIN (multi-country readiness)
// ---------------------------------------------------------------------------

model Country {
  id               String   @id @default(uuid()) @db.Uuid
  isoCode          String   @unique @map("iso_code") @db.Char(2)
  nameEn           String   @map("name_en") @db.VarChar(80)
  nameAr           String   @map("name_ar") @db.VarChar(80)
  defaultCurrency  String   @map("default_currency") @db.Char(3)
  defaultTimeZone  String   @map("default_time_zone") @db.VarChar(64)
  phoneCountryCode String   @map("phone_country_code") @db.VarChar(8)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cities City[]

  @@map("countries")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(120)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country    Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  addresses  UserAddress[]
  businesses Business[]
  zones      DamazonZone[]

  @@unique([countryId, slug])
  @@index([countryId, isActive])
  @@map("cities")
}

// ---------------------------------------------------------------------------
// DAMAZON ZONE DOMAIN
// ---------------------------------------------------------------------------

enum ZoneType {
  personal
  public
  official
}

enum ZoneAvailability {
  always
  scheduled
  temporarily_closed
}

enum CoordinatePrecision {
  exact
  high
  medium
  low
}

model DamazonZone {
  id             String              @id @default(uuid()) @db.Uuid
  ownerId        String?             @map("owner_id") @db.Uuid
  cityId         String?             @map("city_id") @db.Uuid
  name           String              @db.VarChar(120)
  description    String?             @db.VarChar(500)
  instructions   String?             @db.VarChar(500)
  type           ZoneType            @default(personal)
  latitude       Decimal             @db.Decimal(9, 6)
  longitude      Decimal             @db.Decimal(9, 6)
  radiusMeters   Int                 @default(100) @map("radius_meters")
  precisionLevel CoordinatePrecision @default(exact) @map("precision_level")
  availability   ZoneAvailability    @default(always)
  isActive       Boolean             @default(true) @map("is_active")
  isDefault      Boolean             @default(false) @map("is_default")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  owner         User?          @relation("ZoneOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  photos        ZonePhoto[]
  addresses     UserAddress[]
  orders        Order[]
  deliveryTasks DeliveryTask[] @relation("ZonePickup")

  @@index([ownerId])
  @@index([type, isActive])
  @@index([cityId])
  @@index([ownerId, isDefault])
  @@map("damazon_zones")
}

model ZonePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  zoneId     String   @map("zone_id") @db.Uuid
  imageUrl   String   @map("image_url") @db.VarChar(500)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  zone DamazonZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, orderIndex])
  @@map("zone_photos")
}

// ---------------------------------------------------------------------------
// BUSINESS DOMAIN
// ---------------------------------------------------------------------------

enum BusinessType {
  merchant
  restaurant
  delivery_company
}

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

model Business {
  id                      String             @id @default(uuid()) @db.Uuid
  ownerId                 String             @map("owner_id") @db.Uuid
  type                    BusinessType
  name                    String             @db.VarChar(160)
  legalName               String?            @map("legal_name") @db.VarChar(200)
  description             String?            @db.VarChar(1000)
  logoUrl                 String?            @map("logo_url") @db.VarChar(500)
  coverImageUrl           String?            @map("cover_image_url") @db.VarChar(500)
  phone                   String             @db.VarChar(20)
  email                   String?            @db.VarChar(254)
  addressLine             String?            @map("address_line") @db.VarChar(400)
  latitude                Decimal?           @db.Decimal(9, 6)
  longitude               Decimal?           @db.Decimal(9, 6)
  cityId                  String?            @map("city_id") @db.Uuid
  status                  BusinessStatus     @default(DRAFT)
  verificationStatus      VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt              DateTime?          @map("verified_at")
  subscriptionSuspendedAt DateTime?          @map("subscription_suspended_at")
  ratingAverage           Decimal            @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount             Int                @default(0) @map("rating_count")
  commissionBps           Int                @default(0) @map("commission_bps")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  owner             User                   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  city              City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  documents         BusinessDocument[]
  subscriptions     BusinessSubscription[]
  invoices          Invoice[]
  products          Product[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  ingredients       Ingredient[]
  orders            Order[]
  activeForRoles    UserRoleAssignment[]   @relation("ActiveBusinessRole")
  restaurantProfile RestaurantProfile?
  deliveryCompany   DeliveryCompany?
  supportTickets    SupportTicket[]

  @@index([type, status, verificationStatus])
  @@index([ownerId])
  @@index([cityId])
  @@map("businesses")
}

enum BusinessDocumentType {
  commercial_registration
  tax_registration
  identity_document
  bank_letter
  lease_contract
  other
}

model BusinessDocument {
  id                 String               @id @default(uuid()) @db.Uuid
  businessId         String               @map("business_id") @db.Uuid
  documentType       BusinessDocumentType @map("document_type")
  fileUrl            String               @map("file_url") @db.VarChar(500)
  verificationStatus VerificationStatus   @default(PENDING) @map("verification_status")
  reviewedById       String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?            @map("reviewed_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([verificationStatus])
  @@map("business_documents")
}

model RestaurantProfile {
  id                        String   @id @default(uuid()) @db.Uuid
  businessId                String   @unique @map("business_id") @db.Uuid
  cuisineTypes              String[] @default([]) @map("cuisine_types")
  openingHoursJson          Json?    @map("opening_hours")
  averagePreparationMinutes Int      @default(20) @map("average_preparation_minutes")
  acceptsOnlinePayment      Boolean  @default(true) @map("accepts_online_payment")
  minimumOrderMinor         Int      @default(0) @map("minimum_order_minor")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("restaurant_profiles")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION AND BILLING DOMAIN
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  merchant_monthly
  restaurant_monthly
  delivery_company_monthly
}

enum SubscriptionStatus {
  pending
  active
  past_due
  grace_period
  suspended
  cancelled
  expired
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  void
}

model BusinessSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  businessId  String             @map("business_id") @db.Uuid
  plan        SubscriptionPlan
  status      SubscriptionStatus @default(pending)
  amountMinor Int                @map("amount_minor")
  currency    String             @db.Char(3)
  periodStart DateTime           @map("period_start")
  periodEnd   DateTime           @map("period_end")
  graceUntil  DateTime?          @map("grace_until")
  autoRenew   Boolean            @default(true) @map("auto_renew")
  cancelledAt DateTime?          @map("cancelled_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments Payment[]

  @@index([businessId, status])
  @@index([periodEnd])
  @@map("business_subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  status         InvoiceStatus @default(draft)
  amountMinor    Int           @map("amount_minor")
  currency       String        @db.Char(3)
  issuedAt       DateTime?     @map("issued_at")
  paidAt         DateTime?     @map("paid_at")
  dueAt          DateTime      @map("due_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// CATALOG DOMAIN
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  nameEn    String   @map("name_en") @db.VarChar(120)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

enum ProductStatus {
  draft
  active
  inactive
  out_of_stock
  archived
}

enum InventoryOperation {
  restock
  sale
  return
  adjustment
  damage
  reservation
  release
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  categoryId        String?       @map("category_id") @db.Uuid
  sku               String        @db.VarChar(64)
  barcode           String?       @db.VarChar(64)
  nameEn            String        @map("name_en") @db.VarChar(200)
  nameAr            String        @map("name_ar") @db.VarChar(200)
  description       String?       @db.Text
  priceMinor        Int           @map("price_minor")
  discountPercent   Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  currency          String        @default("SYP") @db.Char(3)
  stockQuantity     Int           @default(0) @map("stock_quantity")
  lowStockThreshold Int           @default(0) @map("low_stock_threshold")
  trackInventory    Boolean       @default(true) @map("track_inventory")
  status            ProductStatus @default(draft)
  isAvailable       Boolean       @default(true) @map("is_available")
  ratingAverage     Decimal       @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount       Int           @default(0) @map("rating_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  favorites          Favorite[]
  reviews            Review[]

  @@unique([businessId, sku])
  @@index([categoryId, status])
  @@index([businessId, status])
  @@index([barcode])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  imageUrl   String   @map("image_url") @db.VarChar(500)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, orderIndex])
  @@map("product_images")
}

model ProductVariant {
  id                   String   @id @default(uuid()) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  sku                  String   @db.VarChar(64)
  nameEn               String   @map("name_en") @db.VarChar(120)
  nameAr               String   @map("name_ar") @db.VarChar(120)
  additionalPriceMinor Int      @default(0) @map("additional_price_minor")
  stockQuantity        Int      @default(0) @map("stock_quantity")
  isAvailable          Boolean  @default(true) @map("is_available")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@map("product_variants")
}

model InventoryMovement {
  id            String             @id @default(uuid()) @db.Uuid
  productId     String             @map("product_id") @db.Uuid
  operation     InventoryOperation
  quantity      Int
  balanceAfter  Int                @map("balance_after")
  referenceType String?            @map("reference_type") @db.VarChar(40)
  referenceId   String?            @map("reference_id") @db.Uuid
  note          String?            @db.VarChar(300)
  actorId       String?            @map("actor_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// RESTAURANT MENU DOMAIN
// ---------------------------------------------------------------------------

model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  nameEn       String   @map("name_en") @db.VarChar(120)
  nameAr       String   @map("name_ar") @db.VarChar(120)
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Business   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, position])
  @@map("menu_categories")
}

model MenuItem {
  id                 String   @id @default(uuid()) @db.Uuid
  restaurantId       String   @map("restaurant_id") @db.Uuid
  menuCategoryId     String?  @map("menu_category_id") @db.Uuid
  nameEn             String   @map("name_en") @db.VarChar(160)
  nameAr             String   @map("name_ar") @db.VarChar(160)
  description        String?  @db.VarChar(600)
  priceMinor         Int      @map("price_minor")
  currency           String   @default("SYP") @db.Char(3)
  preparationMinutes Int      @default(15) @map("preparation_minutes")
  isAvailable        Boolean  @default(true) @map("is_available")
  isSoldOut          Boolean  @default(false) @map("is_sold_out")
  imageUrl           String?  @map("image_url") @db.VarChar(500)
