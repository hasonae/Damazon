enum OrderType {
  marketplace
  restaurant
  scheduled
  instant
  gift
  pickup
  damazon_zone
  third_party_recipient
  multi_vendor
  multi_restaurant
}

enum OrderStatus {
  draft
  pending_payment
  confirmed
  preparing
  ready
  driver_assigned
  driver_accepted
  on_the_way
  arrived
  delivered
  completed
  cancelled
  refunded
  returned
  expired
  failed
  disputed
}

enum DeliveryDestinationKind {
  home_address
  damazon_zone
  pickup
  third_party_recipient
}

enum DeliveryAssignmentMode {
  manual
  automatic
  ai
}

enum DeliveryServiceLevel {
  standard
  priority
  scheduled
}

enum OrderActor {
  customer
  seller
  driver
  delivery_company
  payment_gateway
  system
  admin
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(32)
  customerId       String      @map("customer_id") @db.Uuid
  businessId       String      @map("business_id") @db.Uuid
  type             OrderType   @default(marketplace)
  status           OrderStatus @default(draft)
  paymentStatus    String      @default("pending") @map("payment_status") @db.VarChar(32)
  currency         String      @default("SYP") @db.Char(3)
  subtotalMinor    Int         @map("subtotal_minor")
  deliveryFeeMinor Int         @default(0) @map("delivery_fee_minor")
  discountMinor    Int         @default(0) @map("discount_minor")
  taxMinor         Int         @default(0) @map("tax_minor")
  totalMinor       Int         @map("total_minor")
  couponId         String?     @map("coupon_id") @db.Uuid

  destinationKind      DeliveryDestinationKind @default(home_address) @map("destination_kind")
  deliveryZoneId       String?                 @map("delivery_zone_id") @db.Uuid
  deliveryAddressId    String?                 @map("delivery_address_id") @db.Uuid
  deliveryLatitude     Decimal?                @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude    Decimal?                @map("delivery_longitude") @db.Decimal(9, 6)
  deliveryInstructions String?                 @map("delivery_instructions") @db.VarChar(500)
  recipientName        String?                 @map("recipient_name") @db.VarChar(160)
  recipientPhone       String?                 @map("recipient_phone") @db.VarChar(20)

  assignmentMode DeliveryAssignmentMode @default(automatic) @map("assignment_mode")
  serviceLevel   DeliveryServiceLevel   @default(standard) @map("service_level")
  scheduledFor   DateTime?              @map("scheduled_for")

  customerNote        String?   @map("customer_note") @db.VarChar(600)
  cancellationReason  String?   @map("cancellation_reason") @db.VarChar(300)
  placedAt            DateTime? @map("placed_at")
  confirmedAt         DateTime? @map("confirmed_at")
  deliveredAt         DateTime? @map("delivered_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer       User                 @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deliveryZone   DamazonZone?         @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  deliveryTask   DeliveryTask?
  reviews        Review[]
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  supportTickets SupportTicket[]

  @@index([customerId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@index([deliveryZoneId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productId        String? @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  menuItemId       String? @map("menu_item_id") @db.Uuid
  nameSnapshotEn   String  @map("name_snapshot_en") @db.VarChar(200)
  nameSnapshotAr   String  @map("name_snapshot_ar") @db.VarChar(200)
  imageSnapshotUrl String? @map("image_snapshot_url") @db.VarChar(500)
  unitPriceMinor   Int     @map("unit_price_minor")
  quantity         Int
  discountMinor    Int     @default(0) @map("discount_minor")
  totalMinor       Int     @map("total_minor")
  notes            String? @db.VarChar(300)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  OrderActor   @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?      @db.VarChar(400)
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

