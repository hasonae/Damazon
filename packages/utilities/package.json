{
  "name": "@damazon/utilities",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic, dependency-free utilities shared by the Damazon backend and both PWAs.",
  "license": "UNLICENSED",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.types.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-dist-markers.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@damazon/shared-types": "0.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
