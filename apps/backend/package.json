{
  "name": "@damazon/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Damazon backend API - modular NestJS platform with Clean Architecture layering.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,api -c cyan,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --watch dist --ext js --delay 2000ms --exec \\\"node dist/main.js\\\"\"",
    "start:debug": "npm run build && node --inspect --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:reference": "tsx prisma/seed.ts --reference-only",
    "admin:set-credentials": "tsx prisma/set-admin-credentials.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@damazon/shared-types": "0.1.0",
    "@damazon/utilities": "0.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.7",
    "nodemon": "^3.1.14",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
